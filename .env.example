# Copy to apps/web/.env.local for local development.
# See docs/ENVIRONMENT_VARIABLES.md for what each of these is and how to obtain it.
# Never commit a real .env.local — it's already in .gitignore.

# --- Supabase (required to run the app at all) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Calendar OAuth (optional — enables calendar sync) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Web Push (optional — enables browser notifications) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Stripe (optional — enables Premium billing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_ID_PREMIUM_MONTHLY=

# --- Error monitoring (optional) ---
NEXT_PUBLIC_SENTRY_DSN=
